<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.scale</groupId>
    <artifactId>scale-server</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <description>Weighbridge scale serial reader with SSE server</description>

    <organization>
        <name>PRODATA</name>
    </organization>
    <inceptionYear>2026</inceptionYear>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            jSerialComm: cross-platform serial port library.
            Ships with native libs for Windows x86/x64, Linux, macOS.
            No JNI installation required — everything is in the JAR.
        -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.10.4</version>
        </dependency>

        <!--
            Gson: minimal JSON serialization (~200 KB).
            Used only for SSE payload encoding and health endpoint.
        -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!--
            JavaFX: status window UI.
            All three platform classifiers are included so the fat JAR runs on
            Linux, Windows, and macOS without a separate JavaFX installation.
            JavaFX is loaded from the classpath (unnamed module), which triggers
            a cosmetic "Unsupported JavaFX configuration" warning at runtime —
            that warning is suppressed in Main.setupLogging.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
            <classifier>win</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                maven-assembly-plugin: produces a fat ("uber") JAR with all
                dependencies bundled so the client only needs one file to deploy.
                Output: target/scale-server-1.0.0-jar-with-dependencies.jar
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>com.scale.Main</mainClass>
                        </manifest>
                    </archive>
                    <appendAssemblyId>true</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-fat-jar</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!--
        Windows-only profile: runs jpackage after the fat JAR is built to produce
        a self-contained app image at target/dist/ScaleServer/.
        The image bundles a JRE — no Java installation required on the target machine.

        To also produce a single-file installer (.exe):
          1. Install WiX Toolset 3.x on the build machine
          2. Change <type>APP_IMAGE</type> to <type>EXE</type>
    -->
    <profiles>
        <profile>
            <id>windows-package</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <name>ScaleServer</name>
                            <appVersion>${project.version}</appVersion>
                            <vendor>PRODATA</vendor>
                            <input>${project.build.directory}</input>
                            <mainJar>${project.artifactId}-${project.version}-jar-with-dependencies.jar</mainJar>
                            <destination>${project.basedir}/dist</destination>
                            <icon>${project.basedir}/src/main/resources/truck-scale.ico</icon>
                            <type>EXE</type>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
